@model TodoItem
@{ ViewData["Title"]="Eliminar tarea"; }
<div class="row justify-content-center"><div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2>Eliminar tarea</h2><p>¿Seguro que deseas eliminar <strong>@Model.Title</strong>?</p><form asp-action="Delete" method="post"><input asp-for="Id" type="hidden"/><button class="btn btn-danger">Sí, eliminar</button> <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></form></div></div></div></div>
