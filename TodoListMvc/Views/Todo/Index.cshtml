@model TodoListViewModel
@{ ViewData["Title"]="TodoList v2.0"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><span class="badge text-bg-success mb-2">Versión 2.0</span><h1>TodoList v2.0</h1><p class="text-muted mb-0">Buscador, filtro por estado y resumen estadístico.</p></div><a class="btn btn-primary" asp-action="Create">+ Nueva tarea</a></div>
<div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="card shadow-sm border-0"><div class="card-body"><small class="text-muted">Resultados</small><div class="display-6">@Model.Total</div></div></div></div><div class="col-6 col-lg-3"><div class="card shadow-sm border-0"><div class="card-body"><small class="text-muted">Pendientes</small><div class="display-6">@Model.Pending</div></div></div></div><div class="col-6 col-lg-3"><div class="card shadow-sm border-0"><div class="card-body"><small class="text-muted">En progreso</small><div class="display-6">@Model.InProgress</div></div></div></div><div class="col-6 col-lg-3"><div class="card shadow-sm border-0"><div class="card-body"><small class="text-muted">Completadas</small><div class="display-6">@Model.Completed</div></div></div></div></div>
<div class="card shadow-sm border-0 mb-4"><div class="card-body"><form method="get" class="row g-3 align-items-end"><div class="col-md-6"><label class="form-label">Buscar</label><input class="form-control" name="search" value="@Model.Search" placeholder="Título o descripción..."/></div><div class="col-md-4"><label class="form-label">Estado</label><select class="form-select" name="status"><option value="">Todos</option>@foreach(var s in Enum.GetValues<TodoStatus>()){if(Model.Status==s){<option value="@s" selected>@s.ToString().Replace("_"," ")</option>}else{<option value="@s">@s.ToString().Replace("_"," ")</option>}}</select></div><div class="col-md-2 d-grid"><button class="btn btn-dark">Filtrar</button></div></form></div></div>
@if(!Model.Items.Any()){<div class="card shadow-sm border-0"><div class="card-body text-center py-5"><h5>No se encontraron tareas</h5></div></div>}else{<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>ID</th><th>Título</th><th>Descripción</th><th>Estado</th><th>Creada</th><th class="text-end">Acciones</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Id</td><td class="fw-semibold">@item.Title</td><td>@(string.IsNullOrWhiteSpace(item.Description)?"—":item.Description)</td><td><span class="badge text-bg-secondary">@item.Status.ToString().Replace("_"," ")</span></td><td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a></td></tr>}</tbody></table></div></div>}
